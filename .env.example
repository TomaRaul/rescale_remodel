# Copiaza in .env sau seteaza direct in terminal. E nevoie de UNA singura.
# Toate au nivel gratuit; primul gasit castiga, in ordinea de mai jos.

# Google AI Studio — https://aistudio.google.com/apikey  (fara card, limite generoase)
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys  (fara card, foarte rapid)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (modele cu sufix :free)
OPENROUTER_API_KEY=

# Fara nicio cheie se incearca Ollama local (http://localhost:11434).
# Instalare: ollama.com, apoi:  ollama pull llama3.2

# Reglaje optionale.
# LLM_TIMEOUT_MS=9000        cat asteptam un raspuns, per incercare
# LLM_TIMEOUT_SCURT_MS=1800  cat asteapta o incercare care MAI ARE pe cine cadea.
#                            Un raspuns bun vine in 0.5-1.2s; unul care intarzie nu
#                            mai vine deloc, deci nu merita asteptat termenul intreg.
#                            Doar ultimul candidat primeste LLM_TIMEOUT_MS intreg.
#                            Numele vechi, LLM_TIMEOUT_PRIM_MS, se citeste in continuare.
# LLM_PAUZA_COTA_MS=60000    cat ocolim un model care a raspuns "quota exceeded"
# LLM_PAUZA_TACERE_MS=15000  cat ocolim un model care tocmai s-a blocat
# LLM_MEMORIE=200            cate raspunsuri se tin minte (temperatura e 0)
