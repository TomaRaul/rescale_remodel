# Copiaza in .env sau seteaza direct in terminal. E nevoie de UNA singura.
# Toate au nivel gratuit; primul gasit castiga, in ordinea de mai jos.

# Google AI Studio — https://aistudio.google.com/apikey  (fara card, limite generoase)
# Numele asta e cel folosit de proiect de la inceput si merge mai departe: cheia se
# trece explicit in configuratia modelului. Routerul Mastra ar cauta singur
# GOOGLE_API_KEY sau GOOGLE_GENERATIVE_AI_API_KEY — si ele sunt citite, ca rezerva.
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys  (fara card, foarte rapid)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (modele cu sufix :free)
OPENROUTER_API_KEY=

# Ollama local (http://localhost:11434) e ULTIMA rezerva, MEREU — si cand ai o cheie,
# nu doar cand nu ai niciuna. Se incearca dupa ce toate modelele cu cheie au cazut, si
# inaintea parserului de cuvinte-cheie. Intra in lant ca model „compatibil OpenAI".
# Instalare: ollama.com, apoi: ollama pull llama3.2

# ─────────────────────────────────────────────────────────────────────────────
# CONTURI SI SALVAREA PANZELOR (Supabase). Optionale, ca si cheile de mai sus:
# fara ele aplicatia deseneaza la fel, doar ca nu salveaza, iar panoul de cont nu
# apare deloc in pagina. Toate trei se iau din Supabase Dashboard, la
# Project Settings -> API.

# Adresa proiectului, de forma https://<ceva>.supabase.co
SUPABASE_URL=

# Cheia publica. Pleaca in browser prin /api/config si ASA TREBUIE: singura, nu
# deschide nimic, fiindca Row Level Security taie randurile care nu sunt ale
# sesiunii. E cea numita „anon" / „publishable" in dashboard.
SUPABASE_ANON_KEY=

# Cheia de serviciu. NU pleaca niciodata din server. Trece PESTE Row Level
# Security — de aceea fiecare interogare din server/supabase.ts filtreaza ea insasi
# dupa `user_id`, cel scos dintr-un jeton verificat. Daca scapa in browser, oricine
# citeste si sterge randurile tuturor.
SUPABASE_SERVICE_KEY=
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PORTURILE. Trei pagini, trei porturi, acelasi proces.
#
#   PORT_POARTA  8080  autentificarea; singurul loc in care se ajunge fara cont
#   PORT_PANZE   8082  alegi una dintre pânzele tale, sau incepi una noua
#   PORT_PANZA   8081  aplicatia propriu-zisa
#
# Nu e nevoie sa le pui: astea sunt valorile implicite. `PORT` singur mai merge, ca
# inainte, si tine locul lui PORT_POARTA.
#
# ATENTIE daca le schimbi: pentru browser, doua porturi inseamna doua ORIGINI diferite,
# iar sesiunea (`localStorage`) nu trece dintr-una in alta. De aceea paginile isi predau
# sesiunea intre ele prin fragmentul adresei — vezi `Cont.legatura`. Merge cu orice
# cifre, dar toate trei trebuie sa fie DIFERITE; daca doua coincid, serverul spune la
# pornire care pagina castiga.
# PORT_POARTA=8080
# PORT_PANZE=8082
# PORT_PANZA=8081
# ─────────────────────────────────────────────────────────────────────────────

# Reglaje optionale.
# GEMINI_MODEL=gemini-2.5-flash   ce model se incearca primul la Google
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=llama3.2      fixeaza modelul local si sare peste proba de retea
# OLLAMA_URL=http://localhost:11434
# OLLAMA_PROBA_MS=600        cat asteptam lista de modele locale, la construirea lantului
# OLLAMA_PAUZA_MS=30000      cat nu mai intrebam, dupa ce Ollama n-a raspuns
# OLLAMA_REZERVA=0           scoate modelul local din lant. Pune-l pe 0 daca preferi sa
#                            cazi direct pe parserul de cuvinte-cheie — el raspunde
#                            instantaneu, dar stie mult mai putin.
# LLM_MEMORIE=200            cate raspunsuri se tin minte. La temperatura 0, acelasi
#                            prompt pe aceeasi scena da acelasi DSL, deci a doua oara
#                            se serveste din memorie: zero tokeni, zero asteptare.
# MASTRA_TELEMETRY_DISABLED=1  implicit pornit din cod; pune-l pe 0 daca vrei sa trimiti
#                            statistici de folosire catre Mastra.

# Ce NU mai exista dupa trecerea pe Mastra, si de ce:
#   LLM_TIMEOUT_MS, LLM_TIMEOUT_SCURT_MS, OLLAMA_TIMEOUT_MS
#     Termenele per candidat. Mastra alege modelul urmator dupa EROARE, nu dupa ceas,
#     iar un `abortSignal` n-ar taia un candidat, ci tot lantul. Cine vrea plafonul
#     inapoi il pune deasupra, pe apelul agentului.
#   LLM_PAUZA_COTA_MS, LLM_PAUZA_TACERE_MS
#     Ocolirea, intre cereri, a unui model care a raspuns „cota depasita". Lantul e
#     acum al lui Mastra si nu tine minte nimic de la o cerere la alta.
